-- 3. LOGIC ĐỔI MÀU TIA VỆT CHÉM (SLASH VFX / TRAIL / BEAM)
local function OverrideSlashColor(vfx)
    if not Toggles.Aura then return end
    local colorData = ColorTable[Settings.AuraColorMode]
    if not colorData then return end

    if vfx:IsA("Trail") or vfx:IsA("Beam") or vfx:IsA("ParticleEmitter") then
        vfx.Color = colorData.Seq
    elseif vfx:IsA("Highlight") or vfx:IsA("SelectionBox") then
        vfx.FillColor = colorData.Primary
        vfx.OutlineColor = colorData.Primary
    end
end

